{
	"name": "protokit",
	"private": true,
	"type": "module",
	"workspaces": [
		"applications/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun turbo build",
		"dev": "bun turbo dev",
		"typecheck": "bun turbo typecheck",
		"lint": "bun turbo lint",
		"format": "bun turbo format",
		"test": "bun turbo test",
		"db:generate": "bun turbo db:generate",
		"db:migrate": "bun turbo db:migrate",
		"db:validate": "bun turbo db:validate",
		"db:seed": "NODE_ENV=development bun scripts/seed.ts",
		"dev:full": "bun scripts/develop.ts",
		"audit:workflows": "bun .github/scripts/audit-workflows.ts",
		"test:conformance:modern": "NODE_ENV=test bun test packages/mcp/src/conformance-modern.test.ts",
		"test:conformance:legacy": "NODE_ENV=test bun test packages/mcp/src/conformance-legacy.test.ts",
		"test:production-configuration": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/lib/startup-invariants.test.ts",
		"test:development-auth-isolation": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/routes/development-authentication-routes.test.ts",
		"test:tunnel-boundary": "bun test scripts/develop.test.ts",
		"test:extension-advertisement": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/lib/extension-advertisement.test.ts",
		"test:rate-limit-concurrency": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/lib/rate-limit-concurrency.test.ts",
		"test:trusted-proxy": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/lib/trusted-proxy.test.ts applications/web/src/lib/canonicalize-ip-address.test.ts applications/web/src/lib/request-client-identifier.test.ts",
		"test:request-boundaries": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/lib/bounded-request-body.test.ts applications/web/src/lib/pkce-validation.test.ts applications/web/src/lib/reject-duplicate-parameters.test.ts applications/web/src/lib/exact-content-type.test.ts applications/web/src/resolve-public-file.test.ts",
		"test:resource-exhaustion": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test applications/web/src/lib/resource-exhaustion.test.ts",
		"test:workflow-authorization": "bun test ./.github/tests/workflow-authorization.test.ts",
		"test:workflow-prompt-injection": "bun test ./.github/tests/workflow-prompt-injection.test.ts",
		"test:production-migration-gate": "bun test ./.github/tests/production-migration-gate.test.ts",
		"test:container-smoke": "bun scripts/test-container-smoke.ts",
		"test:infrastructure:up": "docker compose -f docker-compose.test.yml up -d --build --wait",
		"test:infrastructure:down": "docker compose -f docker-compose.test.yml down -v",
		"test:infrastructure:migrate": "DATABASE_URL=postgresql://protokit:protokit@db.localtest.me:5432/protokit_test DATABASE_LOCAL_PROXY_URL=http://db.localtest.me:4444/sql bun scripts/migrate.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@template/database": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"turbo": "^2.10.11",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,css,html,md}": [
			"prettier --write"
		],
		"*.{js,ts,tsx}": [
			"eslint --fix"
		]
	},
	"packageManager": "bun@1.3.2",
	"overrides": {
		"zod": "^4.0.0"
	}
}
