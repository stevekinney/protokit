# ============================================================
# Environment mode (required everywhere)
# ============================================================
# No default. Every entry point (dev, test, build, start, the Dockerfile)
# must set this explicitly — an omitted NODE_ENV now fails startup instead
# of silently running as `development`, which is what used to leave
# `GET /auth/dev/login` reachable on any host that forgot to set it.
NODE_ENV=development

# ============================================================
# Database (required)
# ============================================================
# Production must use an encrypted, certificate-verified connection —
# `sslmode=require` (or stronger) in the connection string, never a
# loopback/local host, and never placeholder credentials.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require

# Local development/test only. Points the Neon driver's SQL-over-HTTP
# requests at the local Postgres-backed proxy started by
# `bun run test:infrastructure:up` instead of a real Neon project. Never set
# this outside local development or the test suite — see
# packages/database/CLAUDE.md.
# DATABASE_LOCAL_PROXY_URL=http://db.localtest.me:4444/sql

# ============================================================
# Authentication (optional in development)
# ============================================================
# Session signing secret — generate with: openssl rand -hex 32
# Auto-generated in development if not set (sessions won't survive restarts)
# SESSION_SIGNING_SECRET=

# Google OAuth credentials — required for Google sign-in
# In development, use /auth/dev/login instead
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================================
# Redis (optional in development, required in production)
# ============================================================
# When not set, an in-memory fallback is used for rate limiting and
# resource subscriptions. That fallback is single-process only, so
# NODE_ENV=production refuses to start without REDIS_URL — the atomic,
# shared rate limiter it backs is what makes abuse controls trustworthy
# across multiple server instances. Production also requires the `rediss://`
# (TLS) scheme and refuses a loopback/local host.
# REDIS_URL=redis://localhost:6379

# ============================================================
# MCP Protocol
# ============================================================
# MCP_SERVER_NAME=template-mcp-server
# MCP_ALLOWED_ORIGINS=http://localhost:3000
# MCP_ENABLE_UI_EXTENSION=true
# MCP_CONFORMANCE_MODE=false
# MCP_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# ============================================================
# Rate Limiting
# ============================================================
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
# RATE_LIMIT_TOKEN_MAX=30
# RATE_LIMIT_TOKEN_WINDOW_SECONDS=60
# RATE_LIMIT_MCP_MAX=60
# RATE_LIMIT_MCP_WINDOW_SECONDS=60
# RATE_LIMIT_MCP_CONCURRENT_MAX=10
# RATE_LIMIT_AUTHORIZE_MAX=30
# RATE_LIMIT_AUTHORIZE_WINDOW_SECONDS=60
# RATE_LIMIT_GOOGLE_AUTH_MAX=20
# RATE_LIMIT_GOOGLE_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_REVOKE_MAX=30
# RATE_LIMIT_REVOKE_WINDOW_SECONDS=60
# RATE_LIMIT_HEALTH_MAX=60
# RATE_LIMIT_HEALTH_WINDOW_SECONDS=60
# RATE_LIMIT_FAILED_AUTH_MAX=10
# RATE_LIMIT_FAILED_AUTH_WINDOW_SECONDS=300
# RATE_LIMIT_SESSION_MAX=10
# RATE_LIMIT_SESSION_WINDOW_SECONDS=60

# ============================================================
# Trusted Proxy (optional — only needed behind a reverse proxy or CDN)
# ============================================================
# Forwarding headers (X-Forwarded-For, Forwarded, CF-Connecting-IP) are
# ignored unless both of these are set. Without them, rate limiting and
# every other network-identity check use the raw socket address.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
# TRUSTED_PROXY_HEADER=x-forwarded-for
# TRUSTED_PROXY_HOP_COUNT=1

# ============================================================
# Observability
# ============================================================
# METRICS_API_KEY=
# LOG_LEVEL=info

# ============================================================
# Server
# ============================================================
# PORT=3000

# Set automatically by `scripts/develop.ts --tunnel` — do not set by hand.
# When true, disables /auth/dev/login and conformance fixtures regardless of
# NODE_ENV, because a tunnel makes the dev server reachable from the public
# internet.
# PROTOKIT_TUNNEL_ACTIVE=false
