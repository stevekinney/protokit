{
	"name": "@template/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run src/development.ts",
		"build": "SKIP_ENV_VALIDATION=true bun run src/build.ts",
		"start": "NODE_ENV=production bun run dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "SKIP_ENV_VALIDATION=true bun test",
		"test:end-to-end": "bunx playwright test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/postcss": "^4.3.3",
		"postcss": "^8.5.26",
		"@template/database": "workspace:*",
		"@template/mcp": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"redis": "^6.2.1",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"typescript": "6.0.3"
	}
}
