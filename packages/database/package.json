		"db:migrate": "drizzle-kit migrate",
		"db:validate": "drizzle-kit check"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@t3-oss/env-core": "^0.13.11",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"postgres": "^3.4.9",
		"typescript": "6.0.3"
	}
}
