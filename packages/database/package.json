{
	"name": "@template/database",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts",
		"./env": "./src/env.ts",
		"./migrate": "./src/migrate.ts",
		"./baseline": "./src/baseline.ts",
		"./environment-schema": "./src/environment-schema.ts",
		"./local-proxy": "./src/local-proxy.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "NODE_ENV=test DATABASE_URL=postgresql://protokit:protokit@db.localtest.me:5432/protokit_test DATABASE_LOCAL_PROXY_URL=http://db.localtest.me:4444/sql bun test",
		"lint": "eslint src/",
