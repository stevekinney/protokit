{
	"name": "@lostgradient/mcp",
	"version": "0.1.0",
	"description": "A Model Context Protocol server engine: registries, scope vocabularies, and an OAuth-ready request boundary.",
	"license": "MIT",
	"author": "Steve Kinney <hello@stevekinney.net>",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.map",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./logger": {
			"types": "./dist/logger.d.ts",
			"import": "./dist/logger.js",
			"default": "./dist/logger.js"
		},
		"./env": {
			"types": "./dist/env.d.ts",
			"import": "./dist/env.js",
			"default": "./dist/env.js"
		},
		"./metrics": {
			"types": "./dist/metrics.d.ts",
			"import": "./dist/metrics.js",
			"default": "./dist/metrics.js"
		},
		"./environment-schema": {
			"types": "./dist/environment-schema.d.ts",
			"import": "./dist/environment-schema.js",
			"default": "./dist/environment-schema.js"
		},
		"./version": {
			"types": "./dist/version.d.ts",
			"import": "./dist/version.js",
			"default": "./dist/version.js"
		},
		"./oauth": {
			"types": "./dist/oauth/index.d.ts",
			"import": "./dist/oauth/index.js",
			"default": "./dist/oauth/index.js"
		},
		"./oauth/stores": {
			"types": "./dist/oauth/stores.d.ts",
			"import": "./dist/oauth/stores.js",
			"default": "./dist/oauth/stores.js"
		},
		"./oauth/testing": {
			"types": "./dist/oauth/testing/index.d.ts",
			"import": "./dist/oauth/testing/index.js",
			"default": "./dist/oauth/testing/index.js"
		},
		"./oauth/postgres": {
			"types": "./dist/oauth/postgres/index.d.ts",
			"import": "./dist/oauth/postgres/index.js",
			"default": "./dist/oauth/postgres/index.js"
		},
		"./oauth/client-metadata-documents": {
			"types": "./dist/oauth/client-metadata-documents.d.ts",
			"import": "./dist/oauth/client-metadata-documents.js",
			"default": "./dist/oauth/client-metadata-documents.js"
		},
		"./rate-limit": {
			"types": "./dist/rate-limit/index.d.ts",
			"import": "./dist/rate-limit/index.js",
			"default": "./dist/rate-limit/index.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js",
			"default": "./dist/http/index.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit-mount.d.ts",
			"import": "./dist/sveltekit-mount.js",
			"default": "./dist/sveltekit-mount.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run build.ts",
		"lint": "eslint src/",
		"test": "LOG_LEVEL=info NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost/test bun test --path-ignore-patterns='src/oauth/postgres/index.test.ts'",
		"test:postgres": "LOG_LEVEL=info NODE_ENV=test DATABASE_URL=postgresql://protokit:protokit@localhost:5432/protokit_test bun test src/oauth/postgres/index.test.ts",
		"test:conformance": "NODE_ENV=test MCP_CONFORMANCE_PORT=3137 bun ./src/conformance-server.ts",
		"typecheck": "tsc --noEmit",
		"verify:cimd-runtime": "bun run build && bun run verify-cimd-runtime.ts && node --experimental-strip-types verify-cimd-runtime.ts",
		"verify:package": "bun run verify-package.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/core": "^2.0.0",
		"@modelcontextprotocol/ext-apps": "^1.7.5",
		"@modelcontextprotocol/node": "^2.0.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"drizzle-orm": "^0.45.2",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/pg": "^8.16.0",
		"pg": "^8.16.3",
		"pino-pretty": "^13.1.3",
		"typescript": "6.0.3"
	}
}
